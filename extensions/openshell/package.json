{
  "name": "@astroclaw/openshell-sandbox",
  "version": "2026.5.17",
  "description": "Astroclaw OpenShell sandbox backend",
  "repository": {
    "type": "git",
    "url": "https://github.com/astroclaw/astroclaw"
  },
  "type": "module",
  "dependencies": {
    "openshell": "0.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astroclaw/plugin-sdk": "workspace:*"
  },
  "astroclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@astroclaw/openshell-sandbox",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "astroclawVersion": "2026.5.17",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
