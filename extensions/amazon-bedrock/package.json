{
  "name": "@astroclaw/amazon-bedrock-provider",
  "version": "2026.5.17",
  "description": "Astroclaw Amazon Bedrock provider plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/astroclaw/astroclaw"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1047.0",
    "@aws-sdk/client-bedrock-runtime": "3.1045.0",
    "@aws-sdk/credential-provider-node": "3.972.41",
    "@earendil-works/pi-ai": "0.74.0",
    "@smithy/shared-ini-file-loader": "4.5.2"
  },
  "devDependencies": {
    "@astroclaw/plugin-sdk": "workspace:*"
  },
  "astroclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@astroclaw/amazon-bedrock-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "astroclawVersion": "2026.5.17",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
