{
  "name": "@astroclaw/google-meet",
  "version": "2026.5.17",
  "description": "Astroclaw Google Meet participant plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/astroclaw/astroclaw"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@astroclaw/plugin-sdk": "workspace:*",
    "astroclaw": "workspace:*"
  },
  "peerDependencies": {
    "astroclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "astroclaw": {
      "optional": true
    }
  },
  "astroclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@astroclaw/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "astroclawVersion": "2026.5.17"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
