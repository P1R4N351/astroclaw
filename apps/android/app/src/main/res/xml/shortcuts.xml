<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.ASK_ASTROCLAW"
        app:queryPatterns="@array/ask_astroclaw_query_patterns">
        <intent
            android:action="ai.astroclaw.app.action.ASK_ASTROCLAW"
            android:targetPackage="ai.astroclaw.app"
            android:targetClass="ai.astroclaw.app.MainActivity">
            <parameter
                android:name="prompt"
                android:key="prompt"
                android:mimeType="https://schema.org/Text"
                android:required="true" />
        </intent>
    </capability>
</shortcuts>
