// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "Config/Version.xcconfig"

ASTROCLAW_CODE_SIGN_STYLE = Manual
ASTROCLAW_DEVELOPMENT_TEAM = Y5PE65HELJ

ASTROCLAW_APP_BUNDLE_ID = ai.astroclaw.client
ASTROCLAW_SHARE_BUNDLE_ID = ai.astroclaw.client.share
ASTROCLAW_WATCH_APP_BUNDLE_ID = ai.astroclaw.client.watchkitapp
ASTROCLAW_WATCH_EXTENSION_BUNDLE_ID = ai.astroclaw.client.watchkitapp.extension
ASTROCLAW_ACTIVITY_WIDGET_BUNDLE_ID = ai.astroclaw.client.activitywidget

ASTROCLAW_APP_PROFILE = ai.astroclaw.client Development
ASTROCLAW_SHARE_PROFILE = ai.astroclaw.client.share Development

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"
