// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

ASTROCLAW_CODE_SIGN_STYLE = Automatic
ASTROCLAW_DEVELOPMENT_TEAM = YOUR_TEAM_ID

ASTROCLAW_APP_BUNDLE_ID = ai.astroclaw.client
ASTROCLAW_SHARE_BUNDLE_ID = ai.astroclaw.client.share
ASTROCLAW_ACTIVITY_WIDGET_BUNDLE_ID = ai.astroclaw.client.activitywidget
ASTROCLAW_WATCH_APP_BUNDLE_ID = ai.astroclaw.client.watchkitapp
ASTROCLAW_WATCH_EXTENSION_BUNDLE_ID = ai.astroclaw.client.watchkitapp.extension

// Leave empty with automatic signing.
ASTROCLAW_APP_PROFILE =
ASTROCLAW_SHARE_PROFILE =
ASTROCLAW_WATCH_APP_PROFILE =
ASTROCLAW_WATCH_EXTENSION_PROFILE =
